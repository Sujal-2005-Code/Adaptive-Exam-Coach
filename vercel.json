{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://adaptive-exam-coach.onrender.com/api/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/landing",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/app",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
